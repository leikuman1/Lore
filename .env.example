# The scaffold starts without a database or model credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Supabase Postgres. Prefer the Session pooler (port 5432) or the direct connection.
# Do NOT use the Transaction pooler (port 6543) for Graphile Worker: advisory locks,
# LISTEN/NOTIFY and prepared statements are session-scoped.
# Append ?sslmode=require. Percent-encode reserved characters in the password.
# Nothing creates or migrates a database in the current scaffold.
DATABASE_URL=

# Set MODEL_PROVIDER=mock for the offline stage-one demo (not allowed in production).
# Set MODEL_PROVIDER=magpie to use the local Magpie gateway; MODEL_ID is required.
# MODEL_API=chat for WorkBuddy; responses for Codex models (see /v1/models).
# Empty provider starts health-only. No default Vercel AI Gateway.
MODEL_PROVIDER=
MODEL_ID=
# Configure the service key locally when authentication is required; never commit it.
# A key also needs the matching base URL, model ID and supported API protocol.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_API=chat

# Server-controlled limits; maximum steps must be 1..8, timeout 1..120000 ms.
AGENT_MAX_STEPS=4
AGENT_TIMEOUT_MS=30000
